# Copie para .env. Nunca envie o arquivo real nem a keystore para o repositório.
DEXTOP_KEYSTORE_FILE=../area-de-trabalho-movel-keys/atm-release.jks
DEXTOP_KEY_ALIAS=area-de-trabalho-movel
DEXTOP_STORE_PASSWORD=troque-por-uma-senha-longa-e-aleatoria
DEXTOP_KEY_PASSWORD=troque-por-uma-senha-longa-e-aleatoria

# Opcional: caminho do JSON da conta de serviço da Google Play Developer API.
PLAY_SERVICE_ACCOUNT_JSON=/caminho/absoluto/play-service-account.json
PLAY_TRACK=internal

# ID do aplicativo receptor no Google Cast SDK Console (docs/google-cast-receiver).
DEXTOP_CAST_RECEIVER_APP_ID=
